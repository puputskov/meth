# The standard library
# Functions that are always there: number theory first. A prime and its neighbours:
m:algebra isprime(1000003)
m:algebra primes(50)
# Every whole number is a product of primes:
m:algebra factor(2024)
m:algebra fold((a, b) -> a * b, 1, factor(2024))
# Perfect numbers are the sum of their proper divisors; 28 is one:
m:algebra divisors(28)
m:algebra sigma(28) - 28
# The Fibonacci numbers grow like the golden ratio phi = (1 + sqrt(5)) / 2:
m:algebra fib(30)
m:algebra fib(31) / fib(30)
# The remainder, and the steps of the 3n + 1 walk:
m:algebra mod(-7, 3)
m:algebra map(collatz, range(1, 10))
# Numbers between two values:
m:algebra linspace(0, 10, 5)
# Functions that take a function. Newton's method finds sqrt (2) as the root of x^2 - 2:
m:algebra newton(x -> x^2 - 2, x -> 2x, 1, 6)
# The area under x^2 from 0 to 3, by Simpson's rule (exact for this curve):
m:algebra simpson(x -> x^2, 0, 3, 2)
# The differential equation y' = y with y (0) = 1 has the solution e^x; Runge-Kutta in ten steps:
m:algebra rk4((x, y) -> y, 0, 1, 1/10, 10)
