# The English texts of matlog. A text is found by its code, section.name; the
# codes of the machine readable errors (div_zero ...) are in the code and do
# not change, only the words here do. {name} is a place for a value.
# A copy of this file with the texts of another language, named after it
# (de.mltext) in the folder texts of the settings folder, is used with the
# setting `language`; an entry there replaces the one here.

[errors]
none = no error
syntax = syntax error
div_zero = division by zero
zero_pow_zero = 0 to the power 0 is undefined
not_real = the result is not a real number
domain = argument outside the domain of the function
not_integer = an integer is needed
undefined_name = undefined name
undefined_name_of = undefined name '{name}'
not_function = not a function
not_value = a function is not a number
arity = wrong number of arguments
too_large = value too large
depth = recursion too deep
no_file = included file not found
include_loop = include cycle
size = matrix sizes do not fit
type = these operands cannot be combined
not_exact = an exact number is needed here
cannot_integrate = no closed form found
not_symbolic = not a formula that can be worked on
singular = matrix is singular
dimension_mismatch = the units have different dimensions
unknown_unit = unknown unit
no_limit = no limit found, or the two sides differ
cannot_solve = the equation cannot be solved in closed form
no_memory = out of memory
too_long = the computation took too many steps
unknown = unknown error
parse_unknown = unknown error

parse_ok = no error
parse_unexpected_end = the expression ends too early
parse_unexpected_token = unexpected symbol
parse_expected_expr = an expression is expected here
parse_bad_character = unknown character
parse_bad_superscript = a superscript must be an integer
parse_assign_target = only a name or f(x, ...) can be defined
parse_duplicate_param = the same parameter name twice
parse_too_deep = the expression is nested too deeply
parse_no_memory = out of memory

bool_unexpected_character = unexpected character
bool_expected_operand = an operand is missing
bool_expected_operator = an operator is missing
bool_unbalanced_parenthesis = unbalanced parenthesis
bool_too_many_names = too many names (at most 10)
bool_table_too_big = a table needs at most 6 names
bool_bad_definition = only a name can be defined
lambda_unexpected_character = unexpected character
lambda_expected_term = a term is missing
lambda_expected_parameter = a lambda needs names and then a dot: λx. body
lambda_unbalanced_parenthesis = unbalanced parenthesis
lambda_number_too_big = a number is at most 200
lambda_no_normal_form = no normal form within 5000 steps: the term may not
    have one
lambda_too_big = the term got too big
lambda_bad_definition = only a name can be defined

# The hints shown in an empty editor, one after the other. The parts in braces
# are drawn in the colour of the keys; {ACTION_NAME} is the key of an action.
[hints]
1 = Just type: a line is a note, {ACTION_BLOCK_NEW} starts a math block
2 = Try {1/3 + 1/6}: results are exact fractions
3 = {ACTION_COMMAND} opens the command line, {Tab} completes what you type
4 = {Esc} writes the line you are typing into the session
5 = Units work too: try {3 km to m}
6 = {ACTION_STEPS} shows the steps of the line under the cursor
7 = {ACTION_DOMAIN_PREV} and {ACTION_DOMAIN_NEXT} change the domain of a line
8 = {:symbols on} lets unknown names stay symbols: x + y
9 = {ACTION_FOLD} folds and unfolds a block of lines
10 = {:theme} changes the colours: dark, light, contrast, mono
11 = {:export latex} writes the session as a LaTeX file next to it
12 = {ACTION_UNDO} undoes, {ACTION_REDO} redoes, {ACTION_SAVE} saves,
    {ACTION_QUIT} quits

# The lessons of the tutorial. A lesson is an id with a title and a stage (1: the
# tool, 2: the syntax); its steps are numbered from 1. A step has `check` (what
# the editor must show for the step to be done: action, key, notes, result,
# error, value, domain, state, state_not, command, steps or watch), `arg` for
# some of the checks (the action, the key, the domain, the state, on or off, a
# number), `param` and `param2` for the checks that compare text, the `text`
# the user reads, a `hint` shown after a few keys that did not do it, and the
# `answer`: the keys of a model answer, a key between < > is pressed. A new
# lesson is new entries with a new id. The tests play every answer.
[lessons]
notes.title = Writing and notes
notes.stage = 1
notes.1.check = notes
notes.1.arg = 1
notes.1.text = Welcome. A new line is a note, free text. Type a sentence and press Enter.
notes.1.hint = Type some letters, then press the Enter key.
notes.1.answer = My first note<Enter>
notes.2.check = key
notes.2.arg = Up
notes.2.text = Press Up to go back to your note. The cursor moves across lines like in any text editor.
notes.2.hint = The key with the arrow pointing up.
notes.2.answer = <Up>
notes.3.check = key
notes.3.arg = Enter
notes.3.text = Press End to jump to the end of the line, then Enter: a new line starts below it.
notes.3.hint = End is next to Home. Then the Enter key.
notes.3.answer = <End><Enter>
math.title = Math lines
math.stage = 1
math.1.check = action
math.1.arg = block-new
math.1.text = Press {ACTION_BLOCK_NEW}. A math line starts, in a block of the domain used last (algebra at first).
math.1.hint = Hold Ctrl and press Enter. Some terminals send Shift and Enter together for it.
math.1.answer = <ACTION_BLOCK_NEW>
math.2.check = result
math.2.param = 1/2
math.2.text = Type 1/3 + 1/6. The dim text after it is a preview of the result. Press Enter to keep the line.
math.2.hint = Type the characters 1/3 + 1/6 exactly, then Enter.
math.2.answer = 1/3 + 1/6<Enter>
math.3.check = result
math.3.param = 12
math.3.text = Lines work in order: a name you define is known below it. Type a = 12 and press Enter.
math.3.hint = Type a = 12 and press Enter.
math.3.answer = a = 12<Enter>
math.4.check = result
math.4.param = 5/2
math.4.text = Use it: type a/8 + 1 and press Enter.
math.4.hint = a/8 + 1 with a being 12 gives 5/2.
math.4.answer = a/8 + 1<Enter>
math.5.check = error
math.5.param = div_zero
math.5.text = A line that cannot be computed shows a message in red. Type 1/0 and press Enter.
math.5.hint = One divided by zero.
math.5.answer = 1/0<Enter>
math.6.check = state
math.6.arg = note
math.6.text = Enter on an empty line of a block ends the block, and a note starts below it. Press Enter.
math.6.hint = The line you are on is empty. Press Enter on it.
math.6.answer = <Enter>
moving.title = Moving around
moving.stage = 1
moving.1.check = action
moving.1.arg = goto-first
moving.1.text = {ACTION_GOTO_FIRST} goes to the first line of the session.
moving.1.answer = <ACTION_GOTO_FIRST>
moving.2.check = action
moving.2.arg = goto-last
moving.2.text = {ACTION_GOTO_LAST} goes to the last line.
moving.2.answer = <ACTION_GOTO_LAST>
moving.3.check = action
moving.3.arg = block-prev
moving.3.text = {ACTION_BLOCK_PREV} jumps to the block before, {ACTION_BLOCK_NEXT} to the next one. Press {ACTION_BLOCK_PREV}.
moving.3.answer = <ACTION_BLOCK_PREV>
moving.4.check = action
moving.4.arg = block-next
moving.4.text = {ACTION_BLOCK_NEXT} jumps to the next block.
moving.4.answer = <ACTION_BLOCK_NEXT>
editing.title = Selecting, copying, undo
editing.stage = 1
editing.1.check = action
editing.1.arg = select-line
editing.1.text = Go up one line and press {ACTION_SELECT_LINE} to select the whole line.
editing.1.hint = Press Up, then hold Ctrl and press L.
editing.1.answer = <Up><ACTION_SELECT_LINE>
editing.2.check = action
editing.2.arg = copy
editing.2.text = {ACTION_COPY} copies the selected lines.
editing.2.answer = <ACTION_COPY>
editing.3.check = action
editing.3.arg = paste
editing.3.text = Press Down to leave the selection, then {ACTION_PASTE} to paste the copy below.
editing.3.answer = <Down><ACTION_PASTE>
editing.4.check = action
editing.4.arg = undo
editing.4.text = {ACTION_UNDO} undoes the last change. Try it.
editing.4.answer = <ACTION_UNDO>
editing.5.check = action
editing.5.arg = redo
editing.5.text = {ACTION_REDO} redoes what was undone.
editing.5.answer = <ACTION_REDO>
domains.title = Domains and commands
domains.stage = 1
domains.1.check = action
domains.1.arg = domain-next
domains.1.text = Every math line has a domain: algebra, lambda, pga2, pga3 or boolean. The label at the left shows it. {ACTION_DOMAIN_NEXT} goes to the next domain.
domains.1.hint = Hold Alt and press the right arrow.
domains.1.answer = <ACTION_DOMAIN_NEXT>
domains.2.check = action
domains.2.arg = block-pick
domains.2.text = {ACTION_BLOCK_PICK} chooses the domain of a new block first. Press it.
domains.2.answer = <ACTION_BLOCK_PICK>
domains.3.check = key
domains.3.arg = Esc
domains.3.text = Press Esc to cancel the choice.
domains.3.answer = <Esc>
domains.4.check = command
domains.4.param = mode boolean
domains.4.text = {ACTION_COMMAND} opens the command line. Type mode boolean and press Enter: new blocks are boolean from now on.
domains.4.hint = {ACTION_COMMAND}, then the words mode boolean, then Enter.
domains.4.answer = <ACTION_COMMAND>mode boolean<Enter>
domains.5.check = result
domains.5.param = false
domains.5.text = Start a block with {ACTION_BLOCK_NEW}, type a & ~a and press Enter. In the boolean domain & is and, ~ is not.
domains.5.hint = a and not a is never true.
domains.5.answer = <ACTION_BLOCK_NEW>a & ~a<Enter>
domains.6.check = command
domains.6.param = mode algebra
domains.6.text = Back to algebra: {ACTION_COMMAND}, then mode algebra and Enter.
domains.6.answer = <ACTION_COMMAND>mode algebra<Enter>
steps.title = Results and steps
steps.stage = 1
steps.1.check = result
steps.1.param = -2
steps.1.text = Start a block and write det([[1,2],[3,4]]), the determinant of a matrix. Press Enter.
steps.1.hint = {ACTION_BLOCK_NEW}, then the text, then Enter.
steps.1.answer = <ACTION_BLOCK_NEW>det([[1,2],[3,4]])<Enter>
steps.2.check = steps
steps.2.text = Go up to that line and press {ACTION_STEPS}: the steps of the calculation are shown under it.
steps.2.hint = Press Up once, then {ACTION_STEPS}.
steps.2.answer = <Up><ACTION_STEPS>
steps.3.check = action
steps.3.arg = steps
steps.3.text = {ACTION_STEPS} again hides the steps.
steps.3.answer = <ACTION_STEPS>
help.title = Help and the watch window
help.stage = 1
help.1.check = state
help.1.arg = help
help.1.text = {ACTION_HELP} opens the help. Every page of the documentation is there, and it can be searched.
help.1.answer = <ACTION_HELP>
help.2.check = state_not
help.2.arg = help
help.2.text = Press q to close the help.
help.2.answer = q
help.3.check = watch
help.3.arg = on
help.3.text = {ACTION_WATCH} shows the watch window: every name defined at the line of the cursor, with its type and value.
help.3.answer = <ACTION_WATCH>
help.4.check = watch
help.4.arg = off
help.4.text = {ACTION_WATCH} hides it again.
help.4.answer = <ACTION_WATCH>
numbers.title = Numbers and operators
numbers.stage = 2
numbers.1.check = result
numbers.1.param = 1/2
numbers.1.text = Start a block ({ACTION_BLOCK_NEW}) and write a line whose result is 1/2. Any way will do, 2/4 or 1/3 + 1/6.
numbers.1.hint = Fractions are exact: 2/4 is 1/2.
numbers.1.answer = <ACTION_BLOCK_NEW>2/4<Enter>
numbers.2.check = result
numbers.2.param = -4
numbers.2.text = ^ is the power and -2^2 is -4, not 4. Write a line whose result is -4.
numbers.2.answer = -2^2<Enter>
numbers.3.check = result
numbers.3.param = 120
numbers.3.text = Write a line whose result is 120 with a factorial: 5!
numbers.3.answer = 5!<Enter>
numbers.4.check = result
numbers.4.param = ≈ 1.41421356
numbers.4.text = A root that is not a fraction is an approximation, marked with ≈. Write sqrt(2).
numbers.4.answer = sqrt(2)<Enter>
names.title = Names and functions
names.stage = 2
names.1.check = value
names.1.param = g(2)
names.1.param2 = 7
names.1.text = Define a function g so that g(2) is 7. A function is written g(x) = ...
names.1.hint = For example g(x) = 3x + 1.
names.1.answer = g(x) = 3x + 1<Enter>
names.2.check = result
names.2.param = 12
names.2.text = A name is a whole word: 2x is 2 times x, but xy is one name. Define x = 4, then write 3x on the next line.
names.2.answer = x = 4<Enter>3x<Enter>
names.3.check = result
names.3.param = ≈ 3.14159265
names.3.text = pi and e are constants. Write a line whose result is the approximation of pi.
names.3.answer = pi<Enter>
errors.title = Reading errors
errors.stage = 2
errors.1.check = error
errors.1.param = 
errors.1.text = Write a line with a mistake, 2 +, and press Enter. The message says what is wrong and the place is marked.
errors.1.answer = 2 +<Enter>
errors.2.check = result
errors.2.param = 4
errors.2.text = Write the line right: a line whose result is 4.
errors.2.answer = 2 + 2<Enter>
matrices.title = Matrices
matrices.stage = 2
matrices.1.check = result
matrices.1.param = -2
matrices.1.text = A matrix is a list of rows: [[1,2],[3,4]]. Write a line with its determinant, det([[1,2],[3,4]]), which is -2.
matrices.1.answer = det([[1,2],[3,4]])<Enter>
matrices.2.check = result
matrices.2.param = [[4/5], [7/5]]
matrices.2.text = Solve the system 2x + y = 3 and x + 3y = 5 with solve([[2,1],[1,3]], [3,5]).
matrices.2.answer = solve([[2,1],[1,3]], [3,5])<Enter>
symbolic.title = Derivatives, integrals, limits
symbolic.stage = 2
symbolic.1.check = result
symbolic.1.param = 3x²
symbolic.1.text = Names that stand for nothing are symbols inside the symbolic functions. Differentiate x^3 with diff(x^3, x).
symbolic.1.answer = diff(x^3, x)<Enter>
symbolic.2.check = result
symbolic.2.param = 9
symbolic.2.text = Integrate x^2 from 0 to 3: integrate(x^2, x, 0, 3).
symbolic.2.answer = integrate(x^2, x, 0, 3)<Enter>
symbolic.3.check = result
symbolic.3.param = 1
symbolic.3.text = A limit: limit(sin(x)/x, x, 0).
symbolic.3.answer = limit(sin(x)/x, x, 0)<Enter>
units.title = Units
units.stage = 2
units.1.check = result
units.1.param = 5300 m
units.1.text = Units are part of numbers: write 5 km + 300 m.
units.1.answer = 5 km + 300 m<Enter>
units.2.check = result
units.2.param = 1143/1250 m
units.2.text = to converts: write 3 ft to m.
units.2.answer = 3 ft to m<Enter>
numsys.title = Complex numbers, quaternions, statistics
numsys.stage = 2
numsys.1.check = result
numsys.1.param = 5 + 5i
numsys.1.text = i is the imaginary unit. Multiply (1+2i)*(3-i).
numsys.1.answer = (1+2i)*(3-i)<Enter>
numsys.2.check = result
numsys.2.param = 2i
numsys.2.text = The square root of a negative number is complex: sqrt(-4).
numsys.2.answer = sqrt(-4)<Enter>
numsys.3.check = result
numsys.3.param = k
numsys.3.text = Quaternions use i, j and k: write i*j.
numsys.3.answer = i*j<Enter>
numsys.4.check = result
numsys.4.param = 5/2
numsys.4.text = Statistics: the mean of a list, mean([1,2,3,4]).
numsys.4.answer = mean([1,2,3,4])<Enter>
domains2.title = Boolean algebra and lambda calculus
domains2.stage = 2
domains2.1.check = result
domains2.1.param = true
domains2.1.text = Other domains have their own syntax. Switch with {ACTION_COMMAND}, mode boolean, then start a block and write a | ~a.
domains2.1.answer = <ACTION_COMMAND>mode boolean<Enter><ACTION_BLOCK_NEW>a | ~a<Enter>
domains2.2.check = result
domains2.2.param = y
domains2.2.text = The lambda calculus: switch with mode lambda, start a block and write (λx. x) y. The result is the reduced term.
domains2.2.answer = <ACTION_COMMAND>mode lambda<Enter><ACTION_BLOCK_NEW>(λx. x) y<Enter>
