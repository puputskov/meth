# The standard library: small helpers for numbers and lists

# mod (a, b): the remainder of a divided by b, with the sign of b: mod (-1, 5) is 4
m:algebra mod(a, b) = a - b * floor(a / b)

# sign (x): 1 for a positive x, -1 for a negative one, 0 for zero
m:algebra sign(x) = if (x > 0, 1, if (x < 0, -1, 0))

# frac (x): the part after the point, x less floor (x)
m:algebra frac(x) = x - floor(x)

# trunc (x): the whole part, cut toward zero
m:algebra trunc(x) = sign(x) * floor(abs(x))

# lerp (a, b, t): the point at the fraction t of the way from a to b
m:algebra lerp(a, b, t) = a + (b - a) * t

# clamp (x, lo, hi): x held between lo and hi
m:algebra clamp(x, lo, hi) = max(lo, min(x, hi))

# hypot (a, b): the length of the hypotenuse, sqrt (a^2 + b^2)
m:algebra hypot(a, b) = sqrt(a^2 + b^2)

# deg (r): radians to degrees
m:algebra deg(r) = r * 180 / pi

# rad (d): degrees to radians
m:algebra rad(d) = d * pi / 180

# linspace (a, b, n): n numbers from a to b, evenly spaced, both ends included
m:algebra linspace(a, b, n) = map(k -> lerp(a, b, k / (n - 1)), range(0, n - 1))

# cumprod (xs): the running products of a list
m:algebra cumprod(xs) = map(k -> prod(i, 1, k, xs[i]), range(1, len(xs)))

# dotl (xs, ys): the dot product of two lists of one length
m:algebra dotl(xs, ys) = sum(i, 1, len(xs), xs[i] * ys[i])

# normalize (xs): the list divided by its largest absolute value
m:algebra normalize(xs) = xs / fold((m, x) -> max(m, abs(x)), 0, xs)

# Asserts: lines a:<domain> check the library, the tests run them (true, or the text after =>)
a:algebra mod(-1, 5) == 4
a:algebra sign(-7) => -1
a:algebra frac(5/2) => 1/2
a:algebra trunc(-5/2) => -2
a:algebra lerp(0, 10, 1/4) => 5/2
a:algebra clamp(15, 0, 10) => 10
a:algebra hypot(3, 4) => 5
a:algebra len(linspace(0, 1, 5)) => 5
a:algebra dotl([1, 2, 3], [4, 5, 6]) => 32
