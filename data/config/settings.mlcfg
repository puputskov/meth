# The default settings of meth. Every entry is optional: a missing file or
# a missing entry means the value shown here (the commented ones are chosen
# by meth itself).
#
# Copy this file to the settings folder as settings.mlcfg:
#   Windows  %APPDATA%\meth
#   Linux    $XDG_CONFIG_HOME/meth or ~/.config/meth
#   macOS    ~/Library/Application Support/meth
# METH_CONFIG names another folder. Theme files (config/themes) go in the
# same folder. meth writes the entries it changes (:theme, :colors) here
# and keeps everything else in the file as it is.

[display]
# dark, light, contrast, mono, or the name of a NAME.theme file
theme = dark
# 24bit, 256, 16 or off; by default found from COLORTERM, TERM and NO_COLOR
# colors = 24bit
