# The English texts of matlog. A text is found by its code, section.name; the
# codes of the machine readable errors (div_zero ...) are in the code and do
# not change, only the words here do. {name} is a place for a value.
# A copy of this file with the texts of another language, named after it
# (de.mltext) in the folder texts of the settings folder, is used with the
# setting `language`; an entry there replaces the one here.

[errors]
none = no error
syntax = syntax error
div_zero = division by zero
zero_pow_zero = 0 to the power 0 is undefined
not_real = the result is not a real number
domain = argument outside the domain of the function
not_integer = an integer is needed
undefined_name = undefined name
undefined_name_of = undefined name '{name}'
not_function = not a function
not_value = a function is not a number
arity = wrong number of arguments
too_large = value too large
depth = recursion too deep
no_file = included file not found
include_loop = include cycle
size = matrix sizes do not fit
type = these operands cannot be combined
not_exact = an exact number is needed here
cannot_integrate = no closed form found
not_symbolic = not a formula that can be worked on
singular = matrix is singular
dimension_mismatch = the units have different dimensions
unknown_unit = unknown unit
no_limit = no limit found, or the two sides differ
cannot_solve = the equation cannot be solved in closed form
no_memory = out of memory
too_long = the computation took too many steps
units_in_algebra = units belong to the physics domain (:fix units)
unknown = unknown error
parse_unknown = unknown error

parse_ok = no error
parse_unexpected_end = the expression ends too early
parse_unexpected_token = unexpected symbol
parse_expected_expr = an expression is expected here
parse_bad_character = unknown character
parse_bad_superscript = a superscript must be an integer
parse_assign_target = only a name or f(x, ...) can be defined
parse_duplicate_param = the same parameter name twice
parse_too_deep = the expression is nested too deeply
parse_no_memory = out of memory

bool_unexpected_character = unexpected character
bool_expected_operand = an operand is missing
bool_expected_operator = an operator is missing
bool_unbalanced_parenthesis = unbalanced parenthesis
bool_too_many_names = too many names (at most 10)
bool_table_too_big = a table needs at most 6 names
bool_bad_definition = only a name can be defined
lambda_unexpected_character = unexpected character
lambda_expected_term = a term is missing
lambda_expected_parameter = a lambda needs names and then a dot: λx. body
lambda_unbalanced_parenthesis = unbalanced parenthesis
lambda_number_too_big = a number is at most 200
lambda_no_normal_form = no normal form within 5000 steps: the term may not
    have one
lambda_too_big = the term got too big
lambda_bad_definition = only a name can be defined

# The hints shown in an empty editor, one after the other. The parts in braces
# are drawn in the colour of the keys; {ACTION_NAME} is the key of an action.
[hints]
1 = Just type: a line is a note, {ACTION_BLOCK_NEW} starts a math block
2 = Try {1/3 + 1/6}: results are exact fractions
3 = {ACTION_COMMAND} opens the command line, {Tab} completes what you type
4 = {Esc} writes the line you are typing into the session
5 = Units work too: try {3 km to m}
6 = {ACTION_STEPS} shows the steps of the line under the cursor
7 = {ACTION_DOMAIN_PREV} and {ACTION_DOMAIN_NEXT} change the domain of a line
8 = {:symbols on} lets unknown names stay symbols: x + y
9 = {ACTION_FOLD} folds and unfolds a block of lines
10 = {:theme} changes the colours: dark, light, contrast, mono
11 = {:export latex} writes the session as a LaTeX file next to it
12 = {ACTION_UNDO} undoes, {ACTION_REDO} redoes, {ACTION_SAVE} saves,
    {ACTION_QUIT} quits

# The messages of the editor: the line at the bottom after a command or a key.
[messages]
no_steps = no steps for this line
nothing_to_fold = nothing to fold: the block is one line
written = written
cannot_write = cannot write (give a path: :w name.mlog)
open_needs_path = open: give a path
unsaved_open = unsaved changes (:w saves, :open! discards)
unsaved_quit = unsaved changes (:w saves, :q! discards)
no_such_theme = no such theme
colors_usage = colors: 24bit, 256, 16 or off
map_no_such_action = map KEY ACTION: no such action, see :keys
plot_no_plot = plot: this line has no plot
no_settings_folder = no settings folder
settings_read = settings read
config_usage = config: path, reload, or nothing for the help
tutorial_keys = tutorial: F6 skips a step, :tutorial off leaves
tutorial_left = tutorial left
tutorial_nothing_done = tutorial: nothing is done yet
tutorial_session_changed = the session has changes: :w it, or :tutorial! to leave it
tutorial_usage = tutorial: syntax, off, next, back, show or reset
export_format = export: latex, mathml or markdown
export_options = export: body, errors, a range like 3-12, a path
export_needs_path = export: give a path (the session has no file)
export_file_exists = file exists (:export! replaces it)
export_cannot_write = cannot write the export file
unknown_domain = unknown domain
move_needs_line = m needs a line number to move after
copy_needs_line = t needs a line number to copy after
no_lines = no lines
unknown_command = unknown command
copied = copied
nothing_to_paste = nothing to paste
lines_copied = lines copied
redone = redone
undone = undone
nothing_to_redo = nothing to redo
nothing_to_undo = nothing to undo
opened = opened
new_file = new file
symbols_on = symbols: on
symbols_off = symbols: off
plot_shown = plot: shown in the panel
plot_hidden = plot: hidden
theme_set = theme: {name}
theme_set_nocolor = theme: {name} (colors are off, see :colors)
theme_ignored = ({count} ignored, {report})
theme_now = theme: {name} ({state})
on = on
off = off
colors_now = colors: {level}
keys_bad = settings [keys], {first}
keys_bad_more = settings [keys], {first} (and more)
no_such_setting_named = no such setting: {name}
not_a_value = {name}: not a value
not_a_value_bool = {name}: not a value, use on or off
not_a_value_choice = {name}: not a value, use {values}
settings_path = settings: {path}
example_inserted = {count} lines of {name}
no_example = no example {name}, see :examples
no_snippet = no snippet {name}, see :snippet
exported = exported to {path}
fix_usage = fix: units
fix_units_done = {count} lines are physics lines now
no_help_for = no help for {topic}

# What each action of the editor does, one line (:keys, the page keys).
[actions]
none = no action
undo = undo the last change
redo = redo what was undone
block-new = start a block, last domain
block-pick = start a block, pick the domain
note-toggle = make the line a note, or back
domain-next = the next domain of the line
domain-prev = the previous domain of the line
lines-down = move the selected lines down
lines-up = move the selected lines up
fold = fold or unfold the block
block-next = go to the next block
block-prev = go to the previous block
goto-first = go to the first line
goto-last = go to the last line
select-line = select the line
select-all = select everything
copy = copy the selection or the line
cut = cut the selection or the line
paste = paste
command = open the command line
save = save the session
quit = save and quit
steps = show or hide the line's steps
help = open the help
watch = show or hide the watch window
plot = show or hide the line's plot


# What each command of the command line does (shown when its name is typed).
[commands]
q = quit, asking first when there are unsaved changes
quit = quit, asking first when there are unsaved changes
q! = quit and throw away the unsaved changes
w = save the session, to a file when one is given
write = save the session, to a file when one is given
wq = save and quit
x = save and quit
open = open a session file
open! = open a session file and throw away the unsaved changes
e = open a session file
e! = open a session file and throw away the unsaved changes
mode = the domain of new blocks: algebra, lambda, boolean, physics ...
pga = the dimension of the pga domains: 2 or 3
steps = show or hide the steps of the line
fold = fold the block of the line
unfold = open the folded block of the line
foldall = fold every block
unfoldall = open every block
symbols = on: a name with no value is a symbol; off: it is an error
fix = fix units: algebra lines that use units become physics lines
help = open the documentation, at a page when one is given
export = write the session as latex, mathml or markdown
export! = the same, replacing a file that is there
theme = the colour theme: a built in one or a name.theme file
colors = how many colours the terminal shows
example = put a worked example into the session
examples = list the worked examples
snippet = put a snippet into the session
snippets = list the snippets
watch = show or hide the watch window
plot = show or hide the plot of the line
tutorial = start the tutorial, or leave it
set = show a setting, or change it
config = the settings file: its path, or read it again
keys = list the key bindings
map = bind a key to an action
unmap = remove the binding of a key
undo = take back the last change
redo = do again what was taken back
delete = delete the lines of a range
yank = copy the lines of a range
move = move the lines of a range to after a line
copy = copy the lines of a range to after a line

# What each setting does (:set, matlog config).
[options]
theme = the colour theme (a built in one or a name.theme file)
colors = how many colours the terminal shows
highlight = syntax colours in the editor
watch = the watch window with the names and their values
language = the language of messages, hints and lessons (a texts file)
ghost = the preview of the result while typing

# The help of the command line (matlog help, matlog syntax, matlog schema):
# blocks, the lines as they are.
[help]
proof = <<
matlog proof FILE

Checks the proofs written in FILE (theorem, steps with a reason after `by`,
qed) and prints a line for every line that has a verdict: its number, then
valid, not valid (with values that show it), not checked or a syntax error.
Exit code 1 when a line is not valid or a theorem is not proved.
>>
texts = <<
matlog texts check [FILE]

Compares a translation with the built in English texts: the entries it
lacks, the entries the program does not know, and the places like {name}
that were lost or added. Without FILE it reads texts/LANGUAGE.mltext of the
settings folder (the setting language). A file of one lesson is only blamed
for the entries of that lesson. Exit code 1 when anything is found.
>>
overview = <<
matlog: an exact math shell. Without a command it opens the interactive editor.

usage: matlog [FILE.mlog]
       matlog COMMAND [OPTIONS] [ARGUMENTS]

commands:
  eval EXPR...   evaluate expressions, one result each
  run FILE       evaluate every line of a session file
  lex TEXT       the tokens of a text
  parse TEXT     the syntax tree of a text
  steps EXPR     the steps of an expression, or of FILE:LINE
  help [CMD]     this text, or the help of one command
  syntax         the syntax, functions and domains
  docs list|show|search|check   the documentation
  export FILE FMT   a session as latex, mathml or markdown
  theme [NAME]   the built in themes, or one as a theme file
  config list|get|set|path   the settings
  examples [NAME]   the worked examples, or one as a .mlog file
  vars FILE[:LINE]  the names defined at a line, with type and value
  schema         the shape of the JSON output
  texts check [FILE]   the gaps and mistakes of a translation
  proof FILE     check the proofs in a file
  commands       the list of commands (--format json for tools)
  version        the version

options:
  --format text|json   the output form (default text)
  --session FILE       eval: the session whose definitions are visible
  --domain NAME        eval, steps: the domain of the text (default algebra;
                       boolean and lambda are evaluated)
  --write              eval: keep the new lines in the session file
  --symbols            a name that stands for nothing is a symbol

An argument - reads standard input. Exit codes: 0 success, 1 an expression
was an error, 2 usage error, 3 file error.
>>
eval = <<
matlog eval [--session FILE] [--domain NAME] [--write] [--format text|json] EXPR...

Evaluates each EXPR in order, as lines of a session: a = 3 defines a for
the expressions after it. With --session the definitions of that file are
visible; with --write the new lines are appended to it. An EXPR of - takes
one expression per line from standard input.

examples:
  matlog eval "1/3 + 1/6" "sqrt(2)"
  matlog eval "a = 3" "a^2 + 1" --format json
  matlog eval "det([[1,2],[3,4]])"
  matlog eval --domain boolean "a -> b" "table a & b"
  matlog eval --domain lambda "succ = \x n f. f (n f)" "succ 2"
>>
config = <<
matlog config list [--format text|json]
matlog config get NAME [--format text|json]
matlog config set NAME VALUE
matlog config path

Reads and changes the settings of settings.mlcfg (theme, colors, highlight,
ghost). A setting that is not in the file has its default, and the value auto
means that the terminal decides. MATLOG_CONFIG names another settings folder.
The key bindings are the section [keys] of the file, see the page keys of
matlog docs.
>>
examples = <<
matlog examples [--format text|json]
matlog examples NAME

Without a name lists the worked examples with their titles. With a name prints
that example as a session file, to save and open or to run with matlog run:

  matlog examples calculus-newton-sqrt2 > newton.mlog
  matlog run newton.mlog
>>
vars = <<
matlog vars FILE[:LINE] [--format text|json]

Prints the names that are defined after line LINE of a session file (1 based;
the end of the file without it): variables, functions and the definitions of the
boolean and lambda domains, each with its type and value. A name that was defined
again has one row, its newest value. The JSON form is one object per name:
{"name":"a","type":"exact","value":"3","fresh":true}, fresh for a name that
the line itself defined or changed.
>>
run = <<
matlog run FILE [--format text|json]

Evaluates a session file and prints every line with its result. Includes
are followed. Exit code 1 when any line is an error.
>>
export = <<
matlog export FILE FORMAT [WORDS...]

Writes the session FILE as a document on standard output. FORMAT is
latex, mathml (an HTML page) or markdown. The words after it are
body (no preamble or page), errors (the errors of lines too), a line
range (3 or 3-12, from 1) and a path: with a path the document is
written there instead (an existing file is replaced).
>>
lex = <<
matlog lex TEXT [--format text|json]

Prints the tokens of TEXT: kind, byte offset, byte length and text.
>>
parse = <<
matlog parse TEXT [--format text|json]

Prints the syntax tree of TEXT, e.g. (+ 1 (* 2 x)). Exit code 1 and the place
of the problem when TEXT is not a valid statement.
>>
steps = <<
matlog steps [--session FILE] [--domain NAME] [--format text|json] EXPR
matlog steps [--format text|json] FILE:LINE

Prints the steps of one line: the row operations of a matrix calculation, the
rule used for each part of a derivative or an integral, the changes made by simplify.
With --domain lambda: the beta steps of the reduction; with --domain boolean:
the truth table. Exit code 1 when the line has no steps.
>>
syntax = <<
Numbers      12  3.14  .5   exact fractions: 1/3 + 1/6 is 1/2
Operators    + - * / ^ (right associative)  ! (factorial)  sqrt(x) or the root sign
             -2^2 is -4; implicit product: 2x  2(x+1)  (a)(b)  2pi
Unicode      the same as ASCII: x² for x^2, √ for sqrt, π for pi,
             × · for *, ÷ for /, − for -
Names        letters, digits and _, whole words: xy is one name
Statements   expression | name = expression | f(x, y) = expression
Constants    pi  e   (approximate)
Functions    sqrt abs sin cos tan asin acos atan ln log exp floor ceil round
             min max gcd lcm
Matrices     [[1,2],[3,4]] rows; [1,2,3] a column vector; A^T A^-1 A*B
             det inv transpose trace rank rref solve identity dot cross norm
Symbolic     simplify(f) expand(f) subs(f, x, v) diff(f, x [, n]) integrate(f, x [, a, b]) limit(f, x, a [, side]) solve(f, x);
             inf is infinity; solve gives the real roots of f as a set
             names are symbols inside these: diff(x^3, x) is 3x²; results can be stored
Complex      3 + 4i, i*i = -1, sqrt(-4) = 2i; re im conj abs arg; quaternions
             1 + 2i + 3j + 4k, quat (w, x, y, z), rotate (q, v)
Statistics   mean median mode var std quantile cov corr linfit polyfit histogram
             binomial_pdf normal_cdf ...; data is a list [2, 4, 5] or range (1, 9)
Units        5 km + 300 m, 12 N * 3 m; a to b converts: 3 ft to m;
             dim(x) is the dimension of x as one SI unit
Results      exact (1/2) or approximate (≈ 1.41421356); errors have a code
Domains      algebra, boolean and lambda are evaluated (eval --domain NAME);
             matrices, vectors and equations are part of algebra; pga2 and pga3 are
             stored but not evaluated yet
>>
schema = <<
Every result is one JSON object on one line (JSON Lines).

eval, run:
  {"line":N, "kind":"math|note|include|blank|unknown", "domain":"algebra|boolean|lambda|...",
   "input":"text", "status":"value|error|none",
   "type":"exact|approx|matrix|expr|quantity|boolean|lambda", "value":"7/2", "block":["row",...],
   "error":{"code":"div_zero", "message":"...", "start":N, "len":N}}
  type, value and block only with status value (block: the rows of a matrix, a
  truth table or a lambda trace); type is the domain name for the boolean
  and the lambda domain;
  error only with status error; domain only for kind math.
lex:    {"kind":"number", "start":N, "len":N, "text":"12"}
parse:  {"ok":true, "tree":"(+ 1 2)"} or {"ok":false, "error":{...}}

error codes: syntax div_zero zero_pow_zero not_real domain not_integer
  undefined_name not_function not_value arity too_large depth no_file
  include_loop size type not_exact cannot_integrate not_symbolic
  singular dimension_mismatch unknown_unit no_limit cannot_solve
  no_memory too_long units_in_algebra, and for text that does
  not parse parse_unexpected_end parse_unexpected_token parse_expected_expr
  parse_bad_character parse_bad_superscript parse_assign_target
  parse_duplicate_param parse_too_deep parse_no_memory
boolean: bool_unexpected_character bool_expected_operand bool_expected_operator
  bool_unbalanced_parenthesis bool_too_many_names bool_table_too_big
  bool_bad_definition
lambda: lambda_unexpected_character lambda_expected_term
  lambda_expected_parameter lambda_unbalanced_parenthesis lambda_number_too_big
  lambda_no_normal_form lambda_too_big lambda_bad_definition
>>

# One line for each command of the command line (matlog commands).
[cli]
eval = evaluate expressions
run = evaluate a session file
lex = tokens of a text
parse = syntax tree of a text
steps = steps of an expression or a line
help = usage
syntax = the syntax and functions
docs = read, search and check the documentation
export = a session as latex, mathml or markdown
theme = the built in themes as theme files
config = read and change the settings
examples = worked examples as session files
vars = the names defined at a line of a file
schema = shape of the JSON output
texts = check the texts of a translation
proof = check the proofs of a file
commands = list of commands
version = the version

# Messages of the command line on standard error (usage mistakes, files).
# {path} is the file.
[cli_msg]
cannot_read_path = matlog: cannot read {path}
cannot_write_path = matlog: cannot write {path}
cannot_write_the_session_file = matlog: cannot write the session file
out_of_memory = matlog: out of memory
cannot_read_the_file = matlog: cannot read the file
cannot_read_the_session = matlog: cannot read the session
no_steps_for_this_line = matlog: no steps for this line
no_settings_folder = matlog: no settings folder
cannot_write_settings = matlog: cannot write the settings file
eval_needs_an_expression = eval needs an expression
write_needs_session = --write needs --session
run_needs_one_file = run needs one file
lex_needs_one_text = lex needs one text
parse_needs_one_text = parse needs one text
steps_needs_one_expression_or_file_line = steps needs one expression or FILE:LINE
help_takes_one_command = help takes one command
no_such_command = no such command
docs_needs_list_show_search_or_check = docs needs list, show, search or check
no_such_page = no such page
docs_list_show_id_search_words_or_check = docs: list, show ID, search WORDS or check
export_needs_a_file_and_a_format = export needs a file and a format
no_such_format = no such format
bad_export_option = bad export option
theme_takes_one_name = theme takes one name
no_such_theme = no such theme
no_such_setting = no such setting
not_a_value_for_the_setting = not a value for the setting
config_needs_list_get_name_set_name_value_or = config needs list, get NAME, set NAME VALUE or path
vars_needs_file_or_file_line = vars needs FILE or FILE:LINE
examples_takes_one_name = examples takes one name
no_such_example = no such example
unknown_command = unknown command
format_needs_text_or_json = --format needs text or json
session_needs_a_file = --session needs a file
domain_needs_a_domain_name = --domain needs a domain name
unknown_option = unknown option
try_help = try: matlog help
texts_needs_check = texts needs check [FILE]
proof_needs_file = proof needs one FILE

# Labels of the screen. {title} is the title of the help page.
[ui]
no_name = [no name]
search = Search: {query}
hidden_line = +{count} line
hidden_lines = +{count} lines
more = … +{count} more
watch_title = watch  line {line}  ({count})
plot_title = plot  line {line}  {text}
help_bar = -- HELP -- {title}  (Tab links, Enter follow, Backspace back, / search, q close)

# Pages made while the program runs. {table} is the table of keys.
[pages]
yourkeys = <<
id: yourkeys
title: Your keys
summary: The key bindings in use.
see: keys

The action, its keys and what it does. `:map KEY ACTION` binds a key,
`:unmap KEY` removes one; both are kept in the settings file.

```keys
{table}```
>>

# The report of matlog texts check; {key} is the code of an entry, {place}
# a place like {name} of a text.
[texts_check]
missing = missing: {key}
unknown = not a known text: {key}
place_missing = {key}: the place {place} of the English text is not in the translation
place_extra = {key}: the place {place} is not in the English text
bad_lines = {count} lines are no entry
ok = no problems

# The report of matlog docs check; {id} is the page, {detail} what is wrong.
[docs_check]
see_missing = {id}: see: no such page {detail}
link_missing = {id}: link: no such page {detail}
id_file = {id}: id is not the name of the file {detail}
id_twice = {id}: id is used twice
unreachable = {id}: cannot be reached from the index
example_bad = {id}: {detail}
example_differs = example `{text}` gives `{got}`, the page says `{want}`
no_index = there is no page `index`

# The words for the verdict of a proof line (matlog proof).
[proof_marks]
valid = valid
invalid = not valid
unchecked = not checked
sorry = sorry
syntax = syntax error

# The notes of the proof checker (matlog proofs, the proof domain). A line is
# valid, not valid (a reason), not checked (the engine cannot decide) or has a
# syntax problem.
[proof]
outside = not in a theorem: start with `theorem NAME: LEFT = RIGHT`
theorem_form = write `theorem NAME: LEFT = RIGHT`
step_form = a step is an equation `LEFT = RIGHT  by REASON`
bad_formula = cannot read `{text}` as a formula
no_previous = there is no step above to continue
unknown_by = unknown reason `{word}`: use simplify, expand, hypothesis, step N, lemma NAME or sorry
no_by = not checked: no reason; add `by simplify`, `by expand`, `by hypothesis`, `by step N` or `by lemma NAME`
too_big = not checked: the formula is too big
not_equal = not valid: {point}: {left} ≠ {right}
undecided = not checked: the sides are not the same after {how}
hyp_missing = not checked: no `given` equation says this
step_missing = not valid: there is no step {n} above
step_not_valid = not checked: step {n} is not valid
step_differs = not checked: step {n} does not say this
lemma_unknown = not valid: no proved theorem called `{name}` above
lemma_given = not checked: theorem `{name}` needs hypotheses, which a lemma cannot have yet
lemma_differs = not checked: theorem `{name}` does not say this
rule_name = write the name of a rule: `by rule distributive`
rule_unknown = there is no rule called `{name}` (see the section [rules] of the texts)
rule_no_fit = not checked: the step is not an instance of the rule `{name}`
sorry = sorry: this step is not proved
qed_errors = not proved: some steps are not valid
qed_sorry = not proved: the proof uses sorry
qed_unchecked = not proved: {count} steps are not checked
qed_goal = not proved: the steps stop at {at}, not at the claim
qed_ok = proved

# The rules of a proof (by rule NAME): identities that hold for any formulas in
# place of the letters. The step must be this identity, read either way, at the
# one place where its two sides differ. Add your own: a letter stands for any
# formula, the name is what you write after `by rule`.
[rules]
commute_add = a + b = b + a
commute_mul = a * b = b * a
distribute = a * (b + c) = a * b + a * c
distribute_right = (a + b) * c = a * c + b * c
difference_of_squares = a^2 - b^2 = (a + b) * (a - b)
square_of_sum = (a + b)^2 = a^2 + 2 * a * b + b^2
square_of_difference = (a - b)^2 = a^2 - 2 * a * b + b^2
power_of_product = (a * b)^c = a^c * b^c
power_of_power = (a^b)^c = a^(b * c)
power_sum = a^(b + c) = a^b * a^c
exp_sum = exp (a + b) = exp (a) * exp (b)
pythagoras = sin (a)^2 + cos (a)^2 = 1
sin_double = sin (2 * a) = 2 * sin (a) * cos (a)
cos_double = cos (2 * a) = cos (a)^2 - sin (a)^2
sin_sum = sin (a + b) = sin (a) * cos (b) + cos (a) * sin (b)
cos_sum = cos (a + b) = cos (a) * cos (b) - sin (a) * sin (b)

# The lessons of the tutorial are in the files lessons/en/*.mltext, one lesson per
