# Lesson 11: Matrices
[lessons]
matrices.title = Matrices
matrices.stage = 2

matrices.1.check = result
matrices.1.param = -2
matrices.1.text = A matrix is a list of rows: [[1,2],[3,4]]. Write a line
    with its determinant, det([[1,2],[3,4]]), which is -2.
matrices.1.answer = det([[1,2],[3,4]])<Enter>

matrices.2.check = result
matrices.2.param = [[4/5], [7/5]]
matrices.2.text = Solve the system 2x + y = 3 and x + 3y = 5 with
    solve([[2,1],[1,3]], [3,5]).
matrices.2.answer = solve([[2,1],[1,3]], [3,5])<Enter>
