# Lesson 8: Numbers and operators
[lessons]
numbers.title = Numbers and operators
numbers.stage = 2

numbers.1.check = result
numbers.1.param = 1/2
numbers.1.text = Start a block ({ACTION_BLOCK_NEW}) and write a line whose
    result is 1/2. Any way will do, 2/4 or 1/3 + 1/6.
numbers.1.web = Write a line whose result is 1/2. Any way will do, 2/4 or
    1/3 + 1/6.
numbers.1.hint = Fractions are exact: 2/4 is 1/2.
numbers.1.answer = <ACTION_BLOCK_NEW>2/4<Enter>

numbers.2.check = result
numbers.2.param = -4
numbers.2.text = ^ is the power and -2^2 is -4, not 4. Write a line whose
    result is -4.
numbers.2.answer = -2^2<Enter>

numbers.3.check = result
numbers.3.param = 120
numbers.3.text = Write a line whose result is 120 with a factorial: 5!
numbers.3.answer = 5!<Enter>

numbers.4.check = result
numbers.4.param = ≈ 1.41421356
numbers.4.text = A root that is not a fraction is an approximation, marked
    with ≈. Write sqrt(2).
numbers.4.answer = sqrt(2)<Enter>
