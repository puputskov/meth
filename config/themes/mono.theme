# The built in mono theme of matlog, as a theme file.
# Copy it to the settings folder as NAME.theme, edit it and choose it with
# :theme NAME. Entries that are left out keep the style of the dark theme.
# Styles: #rrggbb (text), on #rrggbb (background), bold dim underline reverse,
# or none. Generated by: matlog theme mono

background   = #000000
text         = none
number       = none
name         = none
function     = bold
constant     = bold
unit         = underline
operator     = none
paren        = dim
keyword      = bold
error        = bold underline
match        = bold underline
unmatched    = reverse
gutter       = dim
result       = dim
result-error = bold
ghost        = dim
hint-key     = bold
note         = none
note-code    = bold
