# The built in light theme of matlog, as a theme file.
# Copy it to the settings folder as NAME.theme, edit it and choose it with
# :theme NAME. Entries that are left out keep the style of the dark theme.
# Styles: #rrggbb (text), on #rrggbb (background), bold dim underline reverse,
# or none. Generated by: matlog theme light

background   = #ffffff
text         = none
number       = #098658
name         = #001080
function     = #795e26
constant     = #0070c1
unit         = #267f99
operator     = #333333
paren        = #7a5c00
keyword      = #af00db
error        = #cd3131 underline
match        = bold underline
unmatched    = #cd3131 bold
gutter       = dim
result       = dim
result-error = #cd3131
ghost        = dim
hint-key     = #0070c1 bold
