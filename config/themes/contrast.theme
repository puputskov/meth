# The built in contrast theme of matlog, as a theme file.
# Copy it to the settings folder as NAME.theme, edit it and choose it with
# :theme NAME. Entries that are left out keep the style of the dark theme.
# Styles: #rrggbb (text), on #rrggbb (background), bold dim underline reverse,
# or none. Generated by: matlog theme contrast

background   = #000000
text         = #ffffff
number       = #7fff7f
name         = #7fdfff
function     = #ffff7f
constant     = #ffbf7f
unit         = #7fffd4
operator     = #ffffff
paren        = #ffffff
keyword      = #ff9fff
error        = #ff7f7f bold underline
match        = #ffffff bold underline
unmatched    = #ff7f7f bold
gutter       = #c0c0c0
result       = #ffffff
result-error = #ff7f7f
ghost        = #c0c0c0
hint-key     = #7fdfff bold
note         = #ffffff
note-code    = #7fffd4
