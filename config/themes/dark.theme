# The built in dark theme of matlog, as a theme file.
# Copy it to the settings folder as NAME.theme, edit it and choose it with
# :theme NAME. Entries that are left out keep the style of the dark theme.
# Styles: #rrggbb (text), on #rrggbb (background), bold dim underline reverse,
# or none. Generated by: matlog theme dark

background   = #1e1e1e
paint        = off
text         = none
number       = #b5cea8
name         = #9cdcfe
function     = #dcdcaa
constant     = #4fc1ff
unit         = #4ec9b0
operator     = #d4d4d4
paren        = #ffd700
keyword      = #c586c0
error        = #f44747 underline
match        = bold underline
unmatched    = #f44747 bold
gutter       = dim
result       = dim
result-error = #f44747
ghost        = dim
hint-key     = #4fc1ff bold
note         = none
note-code    = #4ec9b0
